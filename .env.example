# SkillTrace Environment Configuration

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skilltrace

# In Docker:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/skilltrace

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# App Environment
ENVIRONMENT=development
PORT=8000

# Security
JWT_SECRET_KEY=generate_a_secure_random_key_here

# CORS Configuration (accepts comma-separated URLs or wildcard *)
CORS_ORIGINS=https://skilltrace.onrender.com,http://localhost:3000

# Frontend API URL
VITE_API_URL=http://localhost:8000/api

