# SkillTrace Environment Configuration

# Database Configuration (PostgreSQL with pgvector for production)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://user:password@localhost:5432/skilltrace

# Redis Cache & Message Broker (Render / Docker / Upstash)
REDIS_URL=redis://localhost:6379/0

# App Environment
ENVIRONMENT=production
PORT=8000

# Security (Generate a secure 64+ char random hex string for production)
JWT_SECRET_KEY=replace_with_a_secure_random_key_in_production

# CORS Configuration (Comma-separated URLs or wildcard *)
CORS_ORIGINS=https://skilltracer-app.onrender.com,https://skilltracer.onrender.com,http://localhost:3000,http://localhost:5173

# Frontend API URL (Configured for client-side API routing)
VITE_API_URL=https://skilltracer-app.onrender.com/api

# Optional: Upload storage directory override
# RESUME_UPLOAD_DIR=backend/uploads/resumes

# AI / Semantic Search Configuration
# Set to 'false' in memory-constrained serverless environments to use deterministic 384-d semantic projection
ENABLE_SENTENCE_TRANSFORMER=false
